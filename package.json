{
  "name": "saas-o-matic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador y presupuestador interno de suscripciones SaaS multidivisa.",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @saas-o-matic/backend",
    "dev:frontend": "npm run dev -w @saas-o-matic/frontend",
    "seed": "npm run seed -w @saas-o-matic/backend",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent",
    "lint": "eslint . && tsc -p shared && tsc -p backend && tsc -p frontend"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
