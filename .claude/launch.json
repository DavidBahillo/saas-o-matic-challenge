{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:frontend"],
      "port": 5173
    },
    {
      "name": "frontend-check",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@saas-o-matic/frontend", "--", "--port", "5174", "--strictPort", "--force"],
      "port": 5174
    }
  ]
}
